msgctxt "L2"
msgid "# Checks the rules of the challenge for the AWK entry. Uses a throwaway data dir."
msgstr "# Revisa las reglas del reto para la entrada AWK. Usa una carpeta de datos desechable."

msgctxt "L3"
msgid "# The program is portable awk, so with no AWK set this runs the whole check once under every awk it"
msgstr "# El programa es awk portátil, así que sin AWK definido esto corre la revisión completa una vez con cada awk que"

msgctxt "L4"
msgid "# can find (gawk, mawk, original-awk = the one-true-awk, busybox awk). Choose your own with"
msgstr "# encuentre (gawk, mawk, original-awk = el one-true-awk, awk de busybox). Elige el tuyo con"

msgctxt "L5"
msgid "#   AWKS='gawk|mawk' ./check.sh        (names separated by |)    or    AWK=gawk ./check.sh"
msgstr "#   AWKS='gawk|mawk' ./check.sh        (nombres separados por |)    o    AWK=gawk ./check.sh"

msgctxt "L30"
msgid "# 1. Static: the disclaimer is there, nothing touches a network, and the challenge is one while loop on the limit."
msgstr "# 1. Estático: el aviso está ahí, nada toca una red, y el reto es un solo bucle while sobre el límite."

msgctxt "L34"
msgid "# gawk's own linter, in POSIX mode: no gawk extensions, no shadowed or uninitialized variables."
msgstr "# El linter propio de gawk, en modo POSIX: sin extensiones de gawk, sin variables ocultas ni sin inicializar."

msgctxt "L41"
msgid "# 2. Run it a bunch of times; every run must print a sane record set, and the SQLite rows must agree with it."
msgstr "# 2. Córrelo varias veces; cada ejecución debe imprimir un conjunto de registros sensato, y las filas de SQLite deben coincidir."

msgctxt "L73"
msgid "# 3. The demo_only CHECK constraint is real: a non-demo row must be refused."
msgstr "# 3. La restricción CHECK de demo_only es real: una fila que no sea de demo debe ser rechazada."

msgctxt "C42"
msgid "cats=(Meetings Coding Debugging Learning)"
msgstr "cats=(Reuniones Programación Depuración Aprendizaje)"

msgctxt "C51"
msgid "    mapfile -t rows < <(grep -E '^(Meetings|Coding|Debugging|Learning)\t' <<<\"$out\" || true)"
msgstr "    mapfile -t rows < <(grep -E '^(Reuniones|Programación|Depuración|Aprendizaje)\t' <<<\"$out\" || true)"

msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid "# DEMO ONLY. Fictional timecards, written to a scratch SQLite file under"
msgstr "# DEMO ONLY. Tarjetas de horas ficticias, escritas en un archivo SQLite temporal bajo"

msgctxt "L3"
msgid "# XDG_DATA_HOME. Nothing here touches a real time-reporting system."
msgstr "# XDG_DATA_HOME. Nada de aquí toca un sistema real de registro de horas."

msgctxt "L5"
msgid "# Run:  tclsh timecards.tcl            (text)"
msgstr "# Ejecuta:  tclsh timecards.tcl            (texto)"

msgctxt "L6"
msgid "#       tclsh timecards.tcl --gui      (also a Tk window; add --seconds N to close it by itself)"
msgstr "#           tclsh timecards.tcl --gui     (además, una ventana de Tk; añade --seconds N para que se cierre sola)"

msgctxt "L8"
msgid "# El reto: suma tarjetas de 10 a 19 horas (Meetings, Coding, Debugging,"
msgstr "# El reto: suma tarjetas de 10 a 19 horas (Reuniones, Programación, Depuración,"

msgctxt "L9"
msgid "# Learning, una tras otra) hasta que el total acumulado pase de 40.  En Tcl eso"
msgstr "# Aprendizaje, una tras otra) hasta que el total acumulado pase de 40.  En Tcl eso"

msgctxt "L10"
msgid "# is one while loop in the proc \"draw\".  Everything else is plumbing: a card"
msgstr "# es un bucle while en el procedimiento \"draw\".  Todo lo demás es cañería: una tarjeta"

msgctxt "L11"
msgid "# is a dict, the database is a Tcl command, the window is optional."
msgstr "# es un diccionario, la base de datos es un comando de Tcl, la ventana es opcional."

msgctxt "L23"
msgid "# ---------------------------------------------------------------- the challenge"
msgstr "# ---------------------------------------------------------------- el reto"

msgctxt "L25"
msgid "# One random number of hours, minHours..maxHours."
msgstr "# Un número aleatorio de horas, de minHours a maxHours."

msgctxt "L32"
msgid "# Deal cards until the running total is over the limit, and return them as a"
msgstr "# Reparte tarjetas hasta que el total acumulado supere el límite, y devuélvelas como una"

msgctxt "L33"
msgid "# list of dicts. The card that crosses the line is kept, because the test is"
msgstr "# lista de diccionarios. La tarjeta que cruza la línea se conserva, porque la prueba"

msgctxt "L34"
msgid "# made before the next card is drawn, not after."
msgstr "# se hace antes de sacar la siguiente tarjeta, no después."

msgctxt "L49"
msgid "# ---------------------------------------------------------------- the calendar"
msgstr "# ---------------------------------------------------------------- el calendario"

msgctxt "L51"
msgid "# The ISO-8601 week of right now, e.g. 2026-W46. clock knows %G and %V."
msgstr "# La semana ISO-8601 de ahora mismo, p. ej. 2026-W46. clock conoce %G y %V."

msgctxt "L56"
msgid "# ---------------------------------------------------------------- SQLite"
msgstr "# ---------------------------------------------------------------- SQLite"

msgctxt "L67"
msgid "# Save every card in one transaction. The DEMO ONLY rule lives in the table:"
msgstr "# Guarda cada tarjeta en una sola transacción. La regla DEMO ONLY vive en la tabla:"

msgctxt "L68"
msgid "# CHECK(demo_only=1) means a non-demo row cannot be stored."
msgstr "# CHECK(demo_only=1) significa que no se puede guardar una fila que no sea de demostración."

msgctxt "L70"
msgid "# In \"db eval {... $runId ...}\" Tcl variables are *bound parameters*, not text"
msgstr "# En \"db eval {... $runId ...}\" las variables de Tcl son *parámetros enlazados*, no texto"

msgctxt "L71"
msgid "# pasted into the SQL, so quoting is never our problem. \"dict with\" turns a"
msgstr "# pegado en el SQL, así que entrecomillar nunca es problema nuestro. \"dict with\" convierte"

msgctxt "L72"
msgid "# card's keys (category, hours, total) into local variables to be bound."
msgstr "# las claves de una tarjeta (category, hours, total) en variables locales para enlazarlas."

msgctxt "L100"
msgid "# ---------------------------------------------------------------- display"
msgstr "# ---------------------------------------------------------------- pantalla"

msgctxt "L108"
msgid "# An optional Tk window: a table of the cards and the total. Tk is only"
msgstr "# Una ventana opcional de Tk: una tabla con las tarjetas y el total. Tk solo se"

msgctxt "L109"
msgid "# loaded when asked for, so the text version runs on a machine with no display."
msgstr "# carga cuando se pide, así que la versión de texto corre en una máquina sin pantalla."

msgctxt "L133"
msgid "# A tclsh that has loaded Tk does not exit at the end of the script while"
msgstr "# Un tclsh que ha cargado Tk no termina al final del script mientras"

msgctxt "L134"
msgid "# the main window exists, so close it explicitly."
msgstr "# exista la ventana principal, así que ciérrala explícitamente."

msgctxt "L138"
msgid "# ---------------------------------------------------------------- main"
msgstr "# ---------------------------------------------------------------- principal"

msgctxt "L169"
msgid "# Run main only when this file is the script, not when it is sourced for testing."
msgstr "# Ejecuta main solo cuando este archivo es el script, no cuando se carga con source para probar."

msgctxt "C17"
msgid "    variable categories {Meetings Coding Debugging Learning}"
msgstr "    variable categories {Reuniones Programación Depuración Aprendizaje}"

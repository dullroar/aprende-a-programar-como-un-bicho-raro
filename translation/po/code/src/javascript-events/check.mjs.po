msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L1"
msgid "// The event lab: every claim in README.md about events, ordering, the event loop and failure, run against the real program."
msgstr "// El laboratorio de eventos: cada afirmación de README.md sobre eventos, orden, el bucle de eventos y fallos, ejecutada contra el programa real."

msgctxt "L2"
msgid "// Usage: node --test check.mjs        (PROGRAM=/path/to/mutant.mjs node --test check.mjs runs the same tests on another file)"
msgstr "// Uso: node --test check.mjs        (PROGRAM=/path/to/mutant.mjs node --test check.mjs ejecuta las mismas pruebas sobre otro archivo)"

msgctxt "L17"
msgid "// A world with no randomness and no clock: `hours` is the list of hours the cards will have (10 to 19), in order."
msgstr "// Un mundo sin azar y sin reloj: `hours` es la lista de horas que tendrán las tarjetas (de 10 a 19), en orden."

msgctxt "L18"
msgid "// The scheduler only queues; `drain()` is \"the event loop\", and runs one queued turn at a time."
msgstr "// El planificador solo encola; `drain()` es \"el bucle de eventos\" y ejecuta un turno en cola cada vez."

msgctxt "L33"
msgid "// Log every emit as >name when it starts and <name when it returns, so nesting shows what runs inside what."
msgstr "// Registra cada emit como >name al empezar y <name al volver, para que el anidamiento muestre qué se ejecuta dentro de qué."

msgctxt "C44"
msgid "  assert.deepEqual(rows.map(r => [r.category, r.hours, r.running_total]), [['Meetings', 14, 14], ['Coding', 17, 31], ['Debugging', 15, 46]]);"
msgstr "  assert.deepEqual(rows.map(r => [r.category, r.hours, r.running_total]), [['Reuniones', 14, 14], ['Programación', 17, 31], ['Depuración', 15, 46]]);"

msgctxt "C48"
msgid "  assert.deepEqual(w.lines.filter(l => l.endsWith('\\tDEMO ONLY')), ['Meetings\\t14\\t14\\t2026-W07\\tDEMO ONLY', 'Coding\\t17\\t31\\t2026-W07\\tDEMO ONLY', 'Debugging\\t15\\t46\\t2026-W07\\tDEMO ONLY']);"
msgstr "  assert.deepEqual(w.lines.filter(l => l.endsWith('\\tDEMO ONLY')), ['Reuniones\\t14\\t14\\t2026-W07\\tDEMO ONLY', 'Programación\\t17\\t31\\t2026-W07\\tDEMO ONLY', 'Depuración\\t15\\t46\\t2026-W07\\tDEMO ONLY']);"

msgctxt "C187"
msgid "  assert.deepEqual(CATEGORIES, ['Meetings', 'Coding', 'Debugging', 'Learning']);"
msgstr "  assert.deepEqual(CATEGORIES, ['Reuniones', 'Programación', 'Depuración', 'Aprendizaje']);"

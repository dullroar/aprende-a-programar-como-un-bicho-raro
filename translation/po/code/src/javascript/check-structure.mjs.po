msgctxt "L1"
msgid "// Proves the constraint: after its imports, the file is ONE `for` statement with two semicolons in its header and an"
msgstr "// Demuestra la restricción: después de sus importaciones, el archivo es UNA sola sentencia `for` con dos puntos y coma en su encabezado y un"

msgctxt "L2"
msgid "// empty body. No function, no second statement, no other loop, no eval. Usage: node check-structure.mjs timecards.mjs"
msgstr "// cuerpo vacío. Sin funciones, sin segunda sentencia, sin otro bucle, sin eval. Uso: node check-structure.mjs timecards.mjs"

msgctxt "L5"
msgid "// Blank out comments and string contents, keep the code. Template literals are scanned properly, so code inside a"
msgstr "// Borra los comentarios y el contenido de las cadenas, conserva el código. Las plantillas de texto se recorren bien, así que el código dentro de un"

msgctxt "L6"
msgid "// `${ ... }` (even one that holds another template) still counts as code."
msgstr "// `${ ... }` (incluso uno que contenga otra plantilla) sigue contando como código."

msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid "# Checks the rules of the challenge for the ed entry: ed owns the whole computation, the launcher owns none of it,"
msgstr "# Comprueba las reglas del reto para la entrada de ed: ed se encarga de todo el cálculo y el lanzador de nada,"

msgctxt "L3"
msgid "# and changing the ed program changes the program's behavior in the way the README says. Uses throwaway dirs."
msgstr "# y cambiar el programa de ed cambia el comportamiento del programa como dice el README. Usa directorios desechables."

msgctxt "L14"
msgid "# ---- 1. The constraint is real: the launcher only seeds, loads and shows; ed does the rest."
msgstr "# ---- 1. La restricción es real: el lanzador solo siembra, carga y muestra; ed hace el resto."

msgctxt "L19"
msgid "# no shell escape, no file command, no editing of other files: ed only transforms its own buffer"
msgstr "# sin escape al shell, sin comandos de archivo, sin editar otros archivos: ed solo transforma su propio búfer"

msgctxt "L24"
msgid "# ---- helpers"
msgstr "# ---- ayudantes"

msgctxt "L25"
msgid "# \"d d d d d\" limit -> rows an independent simulation says must be printed"
msgstr "# \"d d d d d\" límite -> filas que una simulación independiente dice que deben imprimirse"

msgctxt "L45"
msgid "# ---- 2. Random runs through the launcher."
msgstr "# ---- 2. Ejecuciones aleatorias a través del lanzador."

msgctxt "L57"
msgid "# ---- 3. Every dice sequence over {0,4,5,9} (1024 of them) and 400 random ones, against the independent simulation."
msgstr "# ---- 3. Cada secuencia de dados sobre {0,4,5,9} (1024 en total) y 400 aleatorias, contra la simulación independiente."

msgctxt "L69"
msgid "# ---- 4. Perturbations: change the ed program, and the behavior changes as predicted. The logic is in the ed program."
msgstr "# ---- 4. Perturbaciones: cambia el programa de ed y el comportamiento cambia como se predijo. La lógica está en el programa de ed."

msgctxt "L70"
msgid "# label, sed expression, dice, limit"
msgstr "# etiqueta, expresión de sed, dados, límite"

msgctxt "L87"
msgid "# ---- 5. Walls: what POSIX forbids stays forbidden. (A negative test is kept for each.)"
msgstr "# ---- 5. Barreras: lo que POSIX prohíbe sigue prohibido. (Se conserva una prueba negativa para cada una.)"

msgctxt "L102"
msgid "# ---- 6. Another ed: busybox ed cannot run the program. Measured, and asserted when busybox is there."
msgstr "# ---- 6. Otro ed: busybox ed no puede ejecutar el programa. Medido, y comprobado cuando busybox está presente."

msgctxt "L105"
msgid "# Capture the finite diagnostic before shortening it so head cannot give ed SIGPIPE."
msgstr "# Captura el diagnóstico finito antes de acortarlo para que head no le dé SIGPIPE a ed."

msgctxt "L114"
msgid "# ---- 7. The schema."
msgstr "# ---- 7. El esquema."

msgctxt "C12"
msgid "rows() { grep -E $'^(Meetings|Coding|Debugging|Learning)\\t' <<<\"$1\" || true; }"
msgstr "rows() { grep -E $'^(Reuniones|Programación|Depuración|Aprendizaje)\\t' <<<\"$1\" || true; }"

msgctxt "C21"
msgid "[[ $(grep -c '^g/\\^\\[A-Za-z\\]\\* \\[0-9\\]\\[0-9\\] x\\*\\$/' timecards.ed) -eq 1 ]] || fail \"expected exactly one iterating global command (the run)\""
msgstr "[[ $(grep -c '^g/\\^\\[A-Za-zÁÉÍÓÚáéíóúñ\\]\\* \\[0-9\\]\\[0-9\\] x\\*\\$/' timecards.ed) -eq 1 ]] || fail \"expected exactly one iterating global command (the run)\""

msgctxt "C26"
msgid "    awk -v limit=\"${2:-40}\" -v digits=\"$1\" 'BEGIN { split(\"Meetings Coding Debugging Learning Meetings\", cat, \" \"); n = split(digits, d, \" \")"
msgstr "    awk -v limit=\"${2:-40}\" -v digits=\"$1\" 'BEGIN { split(\"Reuniones Programación Depuración Aprendizaje Reuniones\", cat, \" \"); n = split(digits, d, \" \")"

msgctxt "C34"
msgid "        BEGIN { split(\"Meetings Coding Debugging Learning Meetings\", want, \" \") }"
msgstr "        BEGIN { split(\"Reuniones Programación Depuración Aprendizaje Reuniones\", want, \" \") }"

msgctxt "C78"
msgid "perturb \"swap two categories\" 's/^1s\\/\\^\\/Meetings \\//1s\\/^\\/Coding \\//; s/^2s\\/\\^\\/Coding \\//2s\\/^\\/Meetings \\//' \"5 5 5 5 5\""
msgstr "perturb \"swap two categories\" 's/^1s\\/\\^\\/Reuniones \\//1s\\/^\\/Programación \\//; s/^2s\\/\\^\\/Programación \\//2s\\/^\\/Reuniones \\//' \"5 5 5 5 5\""

msgctxt "C79"
msgid "[[ $(rows \"$out\" | cut -f1 | tr '\\n' ' ') == \"Coding Meetings Debugging \" ]] || fail \"swapping lines 1 and 2 should swap their categories (got: $(rows \"$out\" | cut -f1 | tr '\\n' ' '))\""
msgstr "[[ $(rows \"$out\" | cut -f1 | tr '\\n' ' ') == \"Programación Reuniones Depuración \" ]] || fail \"swapping lines 1 and 2 should swap their categories (got: $(rows \"$out\" | cut -f1 | tr '\\n' ' '))\""

msgctxt "C80"
msgid "perturb \"no dead rule\" '/^s\\/\\^\\.\\*\\[A-Za-z\\]/d' \"5 5 5 5 5\""
msgstr "perturb \"no dead rule\" '/^s\\/\\^\\.\\*\\[A-Za-zÁÉÍÓÚáéíóúñ\\]/d' \"5 5 5 5 5\""

msgctxt "C107"
msgid "    if grep -qx 'Meetings 17 17' <<<\"$bbout\"; then fail \"busybox ed ran the program; update the README\"; fi"
msgstr "    if grep -qx 'Reuniones 17 17' <<<\"$bbout\"; then fail \"busybox ed ran the program; update the README\"; fi"

msgctxt "C116"
msgid "sqlite3 \"$work/run.db\" \"insert into demo_timecards values(1,'Coding',12,12,'w',0)\" 2>/dev/null && fail \"db accepted a non-demo row\""
msgstr "sqlite3 \"$work/run.db\" \"insert into demo_timecards values(1,'Programación',12,12,'w',0)\" 2>/dev/null && fail \"db accepted a non-demo row\""

msgctxt "C117"
msgid "sqlite3 \"$work/run.db\" \"insert into demo_timecards values(1,'Coding',9,9,'w',1)\" 2>/dev/null && fail \"db accepted 9 hours\""
msgstr "sqlite3 \"$work/run.db\" \"insert into demo_timecards values(1,'Programación',9,9,'w',1)\" 2>/dev/null && fail \"db accepted 9 hours\""

msgstr "5s/^/Reuniones /"

msgctxt "C42"
msgid "g/^[A-Za-z]* [0-9][0-9] x*$/-t.\\"
msgstr "g/^[A-Za-zÁÉÍÓÚáéíóúñ]* [0-9][0-9] x*$/-t.\\"

msgctxt "C44"
msgid "s/^\\([A-Za-z]* [0-9]*\\) \\(x*\\)[A-Za-z]* [0-9]*|\\(x*\\)$/\\1|\\2\\3/\\"
msgstr "s/^\\([A-Za-zÁÉÍÓÚáéíóúñ]* [0-9]*\\) \\(x*\\)[A-Za-zÁÉÍÓÚáéíóúñ]* [0-9]*|\\(x*\\)$/\\1|\\2\\3/\\"

msgctxt "C45"
msgid "s/^.*[A-Za-z]* [0-9]*!\\(x*\\)$/Dead 0!\\1/\\"
msgstr "s/^.*[A-Za-zÁÉÍÓÚáéíóúñ]* [0-9]*!\\(x*\\)$/Dead 0!\\1/\\"

msgctxt "L52"
msgid "# 6. Marks to decimal, again by rewrite rules. Tens first: the bar and fifty marks become \" 5\", and so on."
msgstr "# 6. De marcas a decimal, de nuevo con reglas de reescritura. Primero las decenas: la barra y cincuenta marcas pasan a ser \" 5\", y así sucesivamente."

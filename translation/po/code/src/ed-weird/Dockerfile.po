msgctxt "L1"
msgid "# Container image for the ed entry. Run it with: sandbox/container/run-image.sh src/ed-weird"
msgstr "# Imagen de contenedor para la entrada de ed. Ejecútala con: sandbox/container/run-image.sh src/ed-weird"

msgctxt "L2"
msgid "# The whole computation is GNU ed reading timecards.ed. The base adds ed and sqlite3 on a minimal Ubuntu."
msgstr "# Todo el cálculo es GNU ed leyendo timecards.ed. La base añade ed y sqlite3 sobre un Ubuntu mínimo."

msgctxt "L3"
msgid "# check.sh is for your own machine; the image runs the demo."
msgstr "# check.sh es para tu propia máquina; la imagen ejecuta la demostración."

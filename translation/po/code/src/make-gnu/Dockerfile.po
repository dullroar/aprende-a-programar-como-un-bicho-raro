msgctxt "L1"
msgid "# Container image for the GNU Make entry. Run it with: sandbox/container/run-image.sh src/make-gnu"
msgstr "# Imagen de contenedor para la entrada de GNU Make. Ejecútala con: sandbox/container/run-image.sh src/make-gnu"

msgctxt "L2"
msgid "# Make is the program (it re-executes itself as the loop), so it stays; the base has make and sqlite3"
msgstr "# Make es el programa (se vuelve a ejecutar a sí mismo como bucle), así que se queda; la base trae make y sqlite3"

msgctxt "L3"
msgid "# only. The Makefile is run from a private folder that starts out holding nothing else."
msgstr "# y nada más. El Makefile se ejecuta desde una carpeta privada que empieza sin ningún otro archivo."

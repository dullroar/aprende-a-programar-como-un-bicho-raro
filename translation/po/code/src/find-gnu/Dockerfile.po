msgctxt "L1"
msgid "# Container image for the GNU find entry. Run it with: sandbox/container/run-image.sh src/find-gnu"
msgstr "# Imagen de contenedor para la entrada GNU find. Ejecútala con: sandbox/container/run-image.sh src/find-gnu"

msgctxt "L2"
msgid "# The whole program is one GNU `find` (findutils, from the Ubuntu base) plus mkdir and mktemp (coreutils);"
msgstr "# Todo el programa es un solo `find` de GNU (findutils, de la base Ubuntu) más mkdir y mktemp (coreutils);"

msgctxt "L3"
msgid "# the base adds sqlite3 only. check.sh and build-line.py are for your own machine; the image runs the demo."
msgstr "# la base añade solo sqlite3. check.sh y build-line.py son para tu propia máquina; la imagen ejecuta la demostración."

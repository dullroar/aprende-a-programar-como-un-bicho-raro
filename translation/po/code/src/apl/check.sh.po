msgctxt "L2"
msgid "# Checks the rules of the challenge for the APL entry. Uses a throwaway data dir."
msgstr "# Comprueba las reglas del reto para la entrada de APL. Usa un directorio de datos desechable."

msgctxt "L10"
msgid "# 1. Static: the program is a plain .apl script with the demo disclaimer, and nothing in it touches a network."
msgstr "# 1. Estático: el programa es un script .apl simple con el aviso de demo, y nada en él toca la red."

msgctxt "L14"
msgid "# 2. Run it a bunch of times; every run must print a sane record set, and the SQLite rows must agree with it."
msgstr "# 2. Ejecútalo muchas veces; cada ejecución debe imprimir un conjunto de registros sensato, y las filas de SQLite deben coincidir."

msgctxt "L44"
msgid "# 3. The demo_only CHECK constraint is real: a non-demo row must be refused."
msgstr "# 3. La restricción CHECK de demo_only es real: una fila que no sea demo debe ser rechazada."

msgctxt "C15"
msgid "cats=(Meetings Coding Debugging Learning)"
msgstr "cats=(Reuniones Programación Depuración Aprendizaje)"

msgctxt "C24"
msgid "    mapfile -t rows < <(grep -E '^(Meetings|Coding|Debugging|Learning)\t' <<<\"$out\" || true)"
msgstr "    mapfile -t rows < <(grep -E '^(Reuniones|Programación|Depuración|Aprendizaje)\t' <<<\"$out\" || true)"

msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L1"
msgid ""
"# Container image for the tar checkpoint-clock entry. Run it with: "
"sandbox/container/run-image.sh src/tar-gnu-weird"
msgstr ""
"# Imagen de contenedor para la entrada del reloj de puntos de control de "
"tar. Ejecútala con: sandbox/container/run-image.sh src/tar-gnu-weird"

msgctxt "L2"
msgid ""
"# GNU tar (from the Ubuntu base) writes an archive, and its checkpoints run "
"tick.sh. The base adds sqlite3 only."
msgstr ""
"# GNU tar (de la base Ubuntu) escribe un archivo, y sus puntos de control "
"ejecutan tick.sh. La base solo añade sqlite3."

msgctxt "L3"
msgid "# check.sh is for your own machine; the image runs the demo."
msgstr "# check.sh es para tu propia máquina; la imagen ejecuta la demo."

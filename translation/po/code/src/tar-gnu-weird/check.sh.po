#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid ""
"# Checks the rules of the challenge for the checkpoint-clock entry, and "
"proves that the clock is real: change the"
msgstr ""
"# Comprueba las reglas del reto para la entrada del reloj de puntos de "
"control, y prueba que el reloj es real: cambia el"

msgctxt "L3"
msgid ""
"# archive's layout or tar's checkpoint settings and an independent "
"simulation predicts exactly what changes."
msgstr ""
"# diseño del archivo o los ajustes de puntos de control de tar y una "
"simulación independiente predice exactamente qué cambia."

msgctxt "L15"
msgid ""
"# ---- 1. The ridiculous constraint is real: no loop calls the tick; tar's "
"checkpoint does."
msgstr ""
"# ---- 1. La restricción ridícula es real: ningún bucle llama al tick; lo "
"llama el punto de control de tar."

msgctxt "L17"
msgid ""
"# the only loop in the launcher is the argument parser; nothing loops around"
" tar or the tick"
msgstr ""
"# el único bucle del lanzador es el analizador de argumentos; nada hace "
"bucle alrededor de tar ni del tick"

msgctxt "L28"
msgid ""
"# ---- helpers: an independent simulation of the machine (Park-Miller in "
"awk), and a validator of the rules."
msgstr ""
"# ---- auxiliares: una simulación independiente de la máquina (Park-Miller "
"en awk) y un validador de las reglas."

msgctxt "L29"
msgid ""
"# seed ticks -> rows \"Cat\\thours\\ttotal\" for every card that closes "
"within `ticks` hours, then \"#done\" or \"#stalled\""
msgstr ""
"# semilla ticks -> filas \"Cat\\thoras\\ttotal\" por cada tarjeta que cierra"
" dentro de `ticks` horas, luego \"#done\" o \"#stalled\""

msgctxt "L40"
msgid "# N blocks, -b B, --checkpoint=K  -> ticks"
msgstr "# N bloques, -b B, --checkpoint=K  -> ticks"

msgctxt "L41"
msgid "# label output"
msgstr "# etiqueta salida"

msgctxt "L56"
msgid ""
"# ---- 2. Random runs: the rules, and the clock invariants (a card closes at"
" the tick equal to its running total)."
msgstr ""
"# ---- 2. Ejecuciones aleatorias: las reglas, y los invariantes del reloj "
"(una tarjeta cierra en el tick igual a su total acumulado)."

msgctxt "L72"
msgid "# ---- 3. Without checkpoint events there is no progress."
msgstr "# ---- 3. Sin eventos de punto de control no hay progreso."

msgctxt "L80"
msgid ""
"# ---- 4. Predictions: layout and checkpoint settings, against the "
"simulation."
msgstr ""
"# ---- 4. Predicciones: diseño y ajustes de puntos de control, contra la "
"simulación."

msgctxt "L81"
msgid "# seed N(blocks) B K M label"
msgstr "# semilla N(bloques) B K M etiqueta"

msgctxt "L93"
msgid ""
"# TAR_CHECKPOINT counts RECORDS (K, 2K, 3K, ...), while the machine counts "
"callbacks: so the last value is ticks x K"
msgstr ""
"# TAR_CHECKPOINT cuenta REGISTROS (K, 2K, 3K, ...), mientras que la máquina "
"cuenta llamadas: así que el último valor es ticks x K"

msgctxt "L103"
msgid ""
"# a longer tape changes nothing: the extra ticks arrive after the stop and "
"are idle"
msgstr ""
"# una cinta más larga no cambia nada: los ticks extra llegan después de la "
"parada y quedan inactivos"

msgctxt "L109"
msgid ""
"# ---- 5. What one checkpoint counts: records written. Measured directly, "
"with ragged sizes too."
msgstr ""
"# ---- 5. Qué cuenta un punto de control: registros escritos. Medido "
"directamente, también con tamaños irregulares."

msgctxt "L110"
msgid ""
"# tar options... -> number of checkpoint callbacks (the mode comes from the "
"options)"
msgstr ""
"# opciones de tar... -> número de llamadas de punto de control (el modo "
"viene de las opciones)"

msgctxt "L114"
msgid "# a,b,c,d,e headers+data, 2 end blocks"
msgstr "# a,b,c,d,e cabeceras+datos, 2 bloques finales"

msgctxt "L127"
msgid ""
"# ---- 6. A failing callback cannot stop tar, and leaves the machine where "
"it was."
msgstr ""
"# ---- 6. Una llamada que falla no puede detener a tar, y deja la máquina "
"donde estaba."

msgctxt "L128"
msgid ""
"# Make a private copy of the entry whose transition always fails (it updates"
" a table that does not exist)."
msgstr ""
"# Haz una copia privada de la entrada cuya transición siempre falla "
"(actualiza una tabla que no existe)."

msgctxt "L138"
msgid "# a hostile checkpoint number never reaches SQL"
msgstr "# un número de punto de control hostil nunca llega a SQL"

msgctxt "L143"
msgid "# ---- 7. The schema refuses what it must."
msgstr "# ---- 7. El esquema rechaza lo que debe."

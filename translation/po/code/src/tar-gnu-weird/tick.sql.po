msgctxt "L1"
msgid ""
"-- One checkpoint = one hour = one bounded transition of the machine. Run by"
" tick.sh, with @t = TAR_CHECKPOINT."
msgstr ""
"-- Un punto de control = una hora = una transición acotada de la máquina. Lo"
" ejecuta tick.sh, con @t = TAR_CHECKPOINT."


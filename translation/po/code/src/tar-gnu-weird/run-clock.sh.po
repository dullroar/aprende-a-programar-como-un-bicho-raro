#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid "# Starts the machine and lets tar's checkpoints drive it."
msgstr ""
"# Arranca la máquina y deja que los puntos de control de tar la impulsen."

msgctxt "L3"
msgid ""
"#   sh run-clock.sh [--seed N] [--ticks N] [--members M] [--interval K] "
"[--blocking B]"
msgstr ""
"#   sh run-clock.sh [--seed N] [--ticks N] [--members M] [--interval K] "
"[--blocking B]"

msgctxt "L4"
msgid ""
"# --ticks and --members describe the LAYOUT of the archive. --interval and "
"--blocking are tar's CHECKPOINT"
msgstr ""
"# --ticks y --members describen el DISEÑO del archivo. --interval y "
"--blocking son los ajustes de PUNTO DE CONTROL"

msgctxt "L5"
msgid ""
"# settings (tar --checkpoint=K -b B). Defaults: a 64-record archive, one "
"checkpoint per record, which gives 64 ticks."
msgstr ""
"# de tar (tar --checkpoint=K -b B). Por defecto: un archivo de 64 registros,"
" un punto de control por registro, lo que da 64 ticks."

msgctxt "L6"
msgid ""
"# 64 is more than the longest possible run needs: a run ends by tick 59 at "
"the latest."
msgstr ""
"# 64 es más de lo que necesita la ejecución más larga posible: una ejecución"
" termina como tarde en el tick 59."

msgctxt "L25"
msgid ""
"# The clock. tar reads nothing it was not told to read, runs one fixed "
"command per checkpoint, and writes the tape under $data."
msgstr ""
"# El reloj. tar no lee nada que no se le haya dicho que lea, ejecuta un "
"comando fijo por punto de control y escribe la cinta bajo $data."

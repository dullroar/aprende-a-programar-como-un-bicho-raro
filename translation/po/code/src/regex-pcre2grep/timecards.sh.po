msgctxt "L2"
msgid "# DEMO ONLY. Fictional timecards, written to a scratch SQLite file under XDG_DATA_HOME. See README.md."
msgstr "# DEMO ONLY. Tarjetas de horas ficticias, escritas en un archivo SQLite desechable bajo XDG_DATA_HOME. Consulta README.md."

msgctxt "L4"
msgid "# The program is the pattern below. This script only finds a pcre2grep whose callouts are enabled, moves"
msgstr "# El programa es el patrón de abajo. Este script solo busca un pcre2grep con las llamadas de retorno (callouts) activadas, se mueve"

msgctxt "L5"
msgid "# to the scratch directory, and runs ONE pcre2grep command against a one-line \"tape\". It has no loop,"
msgstr "# al directorio desechable y ejecuta UN solo comando pcre2grep sobre una \"cinta\" de una línea. No tiene bucle,"

msgctxt "L6"
msgid "# does no arithmetic and makes no decisions; the callouts, helper exit codes and backtracking do."
msgstr "# no hace aritmética ni toma decisiones; eso lo hacen las llamadas de retorno, los códigos de salida de los ayudantes y el retroceso."

msgctxt "C18"
msgid "printf '%s\\n' 'MeetingsCodingDebuggingLearningMeetings247250253254254253250247243239236233232232233236239243247251253254254253250247243239235233232232233236239243247251253254254253250246243239235233232232233236240244247251253254254253' |"
msgstr "printf '%s\\n' 'ReunionesProgramaciónDepuraciónAprendizajeReuniones247250253254254253250247243239236233232232233236239243247251253254254253250247243239235233232232233236239243247251253254254253250246243239235233232232233236240244247251253254254253' |"

msgctxt "C20"
msgid "^(?C{/usr/bin/sqlite3|-noheader|demo-timecards.db|CREATE TABLE IF NOT EXISTS runs(id INTEGER PRIMARY KEY,started_at TEXT);CREATE TABLE IF NOT EXISTS demo_timecards(id INTEGER PRIMARY KEY,run_id INTEGER,category TEXT,hours INTEGER CHECK(hours BETWEEN 10 AND 19),running_total INTEGER,iso_week TEXT,created_at TEXT,demo_only INTEGER NOT NULL DEFAULT 1 CHECK(demo_only=1));CREATE TABLE IF NOT EXISTS stop_rule(ok INTEGER CONSTRAINT \"stop rule fired: total exceeds 40\" CHECK(ok=1));INSERT INTO runs(started_at) VALUES(datetime('now','localtime'));SELECT printf('# DEMO ONLY run %d',last_insert_rowid())})(?:(?C{/usr/bin/sqlite3|demo-timecards.db|INSERT INTO stop_rule SELECT coalesce((SELECT max(running_total) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)),0)<=40;DELETE FROM stop_rule})(Meetings|Coding|Debugging|Learning)(?C{/usr/bin/sqlite3|-noheader|-separator|$t|demo-timecards.db|INSERT INTO demo_timecards(run_id,category,hours,running_total,iso_week,created_at) SELECT r,'$1',h,t+h,printf('%s-W%02d',strftime('%Y',date('now','localtime','-3 days','weekday 4')),(strftime('%j',date('now','localtime','-3 days','weekday 4'))-1)/7+1),datetime('now','localtime') FROM (SELECT (SELECT max(id) FROM runs) AS r,10+abs(random())%10 AS h,coalesce((SELECT max(running_total) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)),0) AS t);SELECT category,hours,running_total,iso_week,'DEMO ONLY' FROM demo_timecards WHERE id=last_insert_rowid()}))*(*COMMIT)(?C{/usr/bin/sqlite3|-noheader|demo-timecards.db|SELECT printf('# committed total=%d entries=%d DEMO ONLY',coalesce(max(running_total),0),count(*)) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)})[A-Za-z]*(?:(?C{/usr/bin/test|-t|1})(\\d{3})(?C{|$r$e[48;5;$2m  DEMO ONLY  $e[0m})(?C{/bin/sleep|0.05}))*(*COMMIT)(?:(?C{/usr/bin/test|-t|1})(?C{|$r$e[0m$e[K}))?+(?C{|# the match now returns false, on purpose$n})(*FAIL)"
msgstr "^(?C{/usr/bin/sqlite3|-noheader|demo-timecards.db|CREATE TABLE IF NOT EXISTS runs(id INTEGER PRIMARY KEY,started_at TEXT);CREATE TABLE IF NOT EXISTS demo_timecards(id INTEGER PRIMARY KEY,run_id INTEGER,category TEXT,hours INTEGER CHECK(hours BETWEEN 10 AND 19),running_total INTEGER,iso_week TEXT,created_at TEXT,demo_only INTEGER NOT NULL DEFAULT 1 CHECK(demo_only=1));CREATE TABLE IF NOT EXISTS stop_rule(ok INTEGER CONSTRAINT \"stop rule fired: total exceeds 40\" CHECK(ok=1));INSERT INTO runs(started_at) VALUES(datetime('now','localtime'));SELECT printf('# DEMO ONLY run %d',last_insert_rowid())})(?:(?C{/usr/bin/sqlite3|demo-timecards.db|INSERT INTO stop_rule SELECT coalesce((SELECT max(running_total) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)),0)<=40;DELETE FROM stop_rule})(Reuniones|Programación|Depuración|Aprendizaje)(?C{/usr/bin/sqlite3|-noheader|-separator|$t|demo-timecards.db|INSERT INTO demo_timecards(run_id,category,hours,running_total,iso_week,created_at) SELECT r,'$1',h,t+h,printf('%s-W%02d',strftime('%Y',date('now','localtime','-3 days','weekday 4')),(strftime('%j',date('now','localtime','-3 days','weekday 4'))-1)/7+1),datetime('now','localtime') FROM (SELECT (SELECT max(id) FROM runs) AS r,10+abs(random())%10 AS h,coalesce((SELECT max(running_total) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)),0) AS t);SELECT category,hours,running_total,iso_week,'DEMO ONLY' FROM demo_timecards WHERE id=last_insert_rowid()}))*(*COMMIT)(?C{/usr/bin/sqlite3|-noheader|demo-timecards.db|SELECT printf('# committed total=%d entries=%d DEMO ONLY',coalesce(max(running_total),0),count(*)) FROM demo_timecards WHERE run_id=(SELECT max(id) FROM runs)})[A-Za-zÁÉÍÓÚáéíóúñ]*(?:(?C{/usr/bin/test|-t|1})(\\d{3})(?C{|$r$e[48;5;$2m  DEMO ONLY  $e[0m})(?C{/bin/sleep|0.05}))*(*COMMIT)(?:(?C{/usr/bin/test|-t|1})(?C{|$r$e[0m$e[K}))?+(?C{|# the match now returns false, on purpose$n})(*FAIL)"

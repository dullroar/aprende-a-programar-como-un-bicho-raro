msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid "# Checks the rules of the regex challenge for the Perl track. Uses a throwaway data dir."
msgstr "# Comprueba las reglas del reto de regex para la pista de Perl. Usa un directorio de datos desechable."

msgctxt "L9"
msgid "# 1. The file is one statement (everything but comments, blank lines and `use` lines is a single line),"
msgstr "# 1. El archivo es una sola sentencia (todo salvo comentarios, líneas en blanco y líneas `use` es una única línea),"

msgctxt "L10"
msgid "#    with exactly one top-level match and no loop keywords anywhere outside comments."
msgstr "#    con exactamente una coincidencia de nivel superior y sin palabras clave de bucle fuera de los comentarios."

msgctxt "L18"
msgid "# 2. Run it a bunch of times; every run must print a sane record set, and the SQLite rows must agree with it."
msgstr "# 2. Ejecútalo muchas veces; cada ejecución debe imprimir un conjunto de registros sensato, y las filas de SQLite deben coincidir con él."

msgctxt "L33"
msgid "# The SQLite transaction really committed, and agrees with what was printed."
msgstr "# La transacción de SQLite se confirmó de verdad y coincide con lo que se imprimió."

msgctxt "L39"
msgid "# 3. The demo_only CHECK constraint is real: a non-demo row must be refused."
msgstr "# 3. La restricción CHECK de demo_only es real: una fila que no sea de demostración debe rechazarse."

msgctxt "L43"
msgid "# 4. Exactly 40 continues. Four 10-hour cards total exactly 40, so a fifth card must be drawn: Meetings again, total 50."
msgstr "# 4. Exactamente 40 continúa. Cuatro tarjetas de 10 horas suman exactamente 40, así que se debe sacar una quinta tarjeta: Reuniones otra vez, total 50."

msgctxt "L44"
msgid "#    A copy of the program with every card worth 10 hours makes that the only possible run."
msgstr "#    Una copia del programa en la que cada tarjeta vale 10 horas hace que esa sea la única ejecución posible."

msgctxt "C27"
msgid "    rows=$(grep -cE '^(Meetings|Coding|Debugging|Learning)	' <<<\"$out\" || true)"
msgstr "    rows=$(grep -cE '^(Reuniones|Programación|Depuración|Aprendizaje)	' <<<\"$out\" || true)"

msgctxt "C32"
msgid "    awk -F'\\t' '/^(Meetings|Coding|Debugging|Learning)\\t/ && ($2 < 10 || $2 > 19) { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: hours out of 10-19\"; exit 1; }"
msgstr "    awk -F'\\t' '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ && ($2 < 10 || $2 > 19) { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: hours out of 10-19\"; exit 1; }"

msgctxt "C48"
msgid "mapfile -t rows < <(grep -E '^(Meetings|Coding|Debugging|Learning)	' <<<\"$out\")"
msgstr "mapfile -t rows < <(grep -E '^(Reuniones|Programación|Depuración|Aprendizaje)	' <<<\"$out\")"

msgctxt "C50"
msgid "[[ ${rows[3]} == Learning* && ${rows[4]} == Meetings*$'\\t'10$'\\t'50$'\\t'* ]] || { echo \"FAIL: the fourth card must be Learning and the fifth Meetings with total 50\"; echo \"$out\"; exit 1; }"
msgstr "[[ ${rows[3]} == Aprendizaje* && ${rows[4]} == Reuniones*$'\\t'10$'\\t'50$'\\t'* ]] || { echo \"FAIL: the fourth card must be Aprendizaje and the fifth Reuniones with total 50\"; echo \"$out\"; exit 1; }"

"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "L2"
msgid "# Checks the rules of the challenge for the CMake track. Uses a throwaway data dir and a throwaway working dir."
msgstr "# Revisa las reglas del reto para la pista de CMake. Usa una carpeta de datos desechable y una carpeta de trabajo desechable."

msgctxt "L3"
msgid "# Needs cmake (3.19+) on PATH, e.g. `uv tool install cmake`."
msgstr "# Necesita cmake (3.19 o superior) en el PATH, por ejemplo `uv tool install cmake`."

msgctxt "L14"
msgid "# 1. The stunt is real. The whole program is ONE bodiless while(): its condition is the machine. No functions,"
msgstr "# 1. La acrobacia es real. Todo el programa es UN while() sin cuerpo: su condición es la máquina. Sin funciones,"

msgctxt "L15"
msgid "#    macros, includes or cmake_language() to hide a RunEverything() in; nothing between while() and endwhile();"
msgstr "#    macros, includes ni cmake_language() donde esconder un RunEverything(); nada entre while() y endwhile();"

msgctxt "L16"
msgid "#    and nothing before the loop computes (no math, no list/string surgery besides drawing the seed tape)."
msgstr "#    y nada antes del bucle calcula (sin math, sin cirugía de list o string aparte de sacar la cinta semilla)."

msgctxt "L24"
msgid "# Only sqlite3 (and wt.exe for POP, and cmake itself for its own sleep) may be started; no shell, no coreutils."
msgstr "# Solo se puede iniciar sqlite3 (y wt.exe para POP, y cmake mismo para su propia pausa); ni shell ni coreutils."

msgctxt "L28"
msgid "# 2. Run it a bunch of times; every run must print a sane record set, and the SQLite rows must agree with it."
msgstr "# 2. Córrelo muchas veces; cada corrida debe imprimir un conjunto de registros sensato, y las filas de SQLite deben coincidir."

msgctxt "L49"
msgid "# ISO week matches SQLite's date arithmetic, in local time like the other entries."
msgstr "# La semana ISO coincide con la aritmética de fechas de SQLite, en hora local como las otras entradas."

msgctxt "L59"
msgid "# 3. CMake's strftime has %V but no %G: the ISO year is patched by hand. Sweep the year boundaries against date(1)."
msgstr "# 3. El strftime de CMake tiene %V pero no %G: el año ISO se corrige a mano. Recorre los límites de año contra date(1)."

msgctxt "L67"
msgid "# 4. The glow: silent on a pipe, 24 frames in 1-3 s on a pty, and the banner is erased."
msgstr "# 4. El resplandor: silencioso en una tubería, 24 cuadros en 1 a 3 s en un pty, y el letrero se borra."

msgctxt "L78"
msgid "# 4b. Mutation: the stop rule really is the 41-character literal in the condition. Make it 51 and runs stop later,"
msgstr "# 4b. Mutación: la regla de parada es de verdad el literal de 41 caracteres de la condición. Hazlo de 51 y las corridas paran más tarde,"

msgctxt "L79"
msgid "#     so some total must exceed the legal maximum of 59."
msgstr "#     así que algún total debe superar el máximo legal de 59."

msgctxt "L88"
msgid "# 5. The demo_only CHECK constraint is real."
msgstr "# 5. La restricción CHECK de demo_only es real."

msgctxt "C37"
msgid "    rows=$(grep -cE '^(Meetings|Coding|Debugging|Learning)\t' <<<\"$out\" || true)"
msgstr "    rows=$(grep -cE '^(Reuniones|Programación|Depuración|Aprendizaje)\t' <<<\"$out\" || true)"

msgctxt "C40"
msgid "    awk -F'\\t' '/^(Meetings|Coding|Debugging|Learning)\\t/ && ($2 < 10 || $2 > 19) { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: hours out of 10-19\"; exit 1; }"
msgstr "    awk -F'\\t' '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ && ($2 < 10 || $2 > 19) { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: hours out of 10-19\"; exit 1; }"

msgctxt "C41"
msgid "    cats=$(awk -F'\\t' '/^(Meetings|Coding|Debugging|Learning)\\t/ { printf \"%s \", $1 }' <<<\"$out\")"
msgstr "    cats=$(awk -F'\\t' '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ { printf \"%s \", $1 }' <<<\"$out\")"

msgctxt "C42"
msgid "    [[ \"Meetings Coding Debugging Learning \" == \"$cats\"* ]] || { echo \"FAIL run $i: categories out of order: $cats\"; exit 1; }"
msgstr "    [[ \"Reuniones Programación Depuración Aprendizaje \" == \"$cats\"* ]] || { echo \"FAIL run $i: categories out of order: $cats\"; exit 1; }"

msgctxt "C43"
msgid "    awk -F'\\t' '/^(Meetings|Coding|Debugging|Learning)\\t/ { s += $2; if ($3 != s || $5 != \"DEMO ONLY\") bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: running total or DEMO ONLY column wrong\"; exit 1; }"
msgstr "    awk -F'\\t' '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ { s += $2; if ($3 != s || $5 != \"DEMO ONLY\") bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: running total or DEMO ONLY column wrong\"; exit 1; }"

msgctxt "C44"
msgid "    awk -F'\\t' -v n=\"$rows\" '/^(Meetings|Coding|Debugging|Learning)\\t/ { k++; if (k < n && $3 > 40) bad = 1; if (k == n && $3 <= 40) bad = 1 } END { exit bad }' <<<\"$out\" \\"
msgstr "    awk -F'\\t' -v n=\"$rows\" '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ { k++; if (k < n && $3 > 40) bad = 1; if (k == n && $3 <= 40) bad = 1 } END { exit bad }' <<<\"$out\" \\"

msgctxt "C51"
msgid "    awk -F'\\t' -v want=\"$want\" '/^(Meetings|Coding|Debugging|Learning)\\t/ && $4 != want { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: ISO week differs from SQLite's $want\"; exit 1; }"
msgstr "    awk -F'\\t' -v want=\"$want\" '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ && $4 != want { bad = 1 } END { exit bad }' <<<\"$out\" || { echo \"FAIL run $i: ISO week differs from SQLite's $want\"; exit 1; }"

msgctxt "C63"
msgid "    got=$(SOURCE_DATE_EPOCH=$t TZ=UTC run 2>/dev/null | awk -F'\\t' '/^(Meetings|Coding|Debugging|Learning)\\t/ { print $4; exit }' || true)"
msgstr "    got=$(SOURCE_DATE_EPOCH=$t TZ=UTC run 2>/dev/null | awk -F'\\t' '/^(Reuniones|Programación|Depuración|Aprendizaje)\\t/ { print $4; exit }' || true)"

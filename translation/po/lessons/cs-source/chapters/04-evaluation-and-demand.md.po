msgctxt "s-17e0f6a0513e-0007"
msgid "define: no work yet"
msgstr "Definir: aún sin cálculo"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:15
msgctxt "s-c30dbc1c8264-0008"
msgid "enumerate: 1, 2"
msgstr "Enumerar: 1, 2"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:15
msgctxt "s-04b2a2ee6ace-0009"
msgid "enumerate again: may redo"
msgstr "Volver a enumerar: puede recalcular"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:17
msgctxt "s-2d7f4b89848d-0010"
msgid "Lazy, by need"
msgstr "Perezosa, por necesidad"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:18
msgctxt "s-78a7eb2da4ae-0011"
msgid "build thunks"
msgstr "Crear thunks"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:18
msgctxt "s-815702da00ff-0012"
msgid "demand 1: cache"
msgstr "Demanda del 1: guardar"

#: lessons/cs-source/chapters/04-evaluation-and-demand.md:18

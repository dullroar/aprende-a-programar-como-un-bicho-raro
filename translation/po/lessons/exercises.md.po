msgctxt "s-5190377b5f16-0205"
msgid "Write a check for ⟦CODE_0001⟧'s rule: *no loop or branch words, no variables and ⟦CODE_0002⟧ is read at least twice.*"
msgstr "Escribe una comprobación para la regla de ⟦CODE_0001⟧: *sin palabras de bucle ni de rama, sin variables y ⟦CODE_0002⟧ se lee al menos dos veces.*"


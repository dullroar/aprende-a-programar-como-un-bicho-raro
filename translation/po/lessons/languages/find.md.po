msgctxt "s-13c4c3428d51-0036"
msgid "See [exercises](⟦DEST_0001⟧) and [B15](⟦DEST_0002⟧)."
msgstr ""

#: lessons/languages/find.md:108
msgctxt "s-ac0e260e97bf-0037"
msgid "Computer science behind this page"
msgstr ""
